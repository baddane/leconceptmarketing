---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../lib/site";
import type { CategoryInfo } from "../lib/posts";

interface Props {
  title: string;
  description?: string;
  image?: string | null;
  type?: "website" | "article";
  noindex?: boolean;
  categories?: CategoryInfo[];
  publishedTime?: string;
}

const {
  title,
  description = SITE.description,
  image = null,
  type = "website",
  noindex = false,
  categories = [],
  publishedTime,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const fullTitle = title === SITE.title ? title : `${title} — ${SITE.title}`;
const ogImage = image ? new URL(image, Astro.site ?? SITE.url).href : undefined;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem("theme");
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <script is:inline>
      // Certaines illustrations pointent vers des sites tiers qui ont disparu
      // depuis. Plutot que l'icone d'image cassee du navigateur, on rend le
      // meme emplacement neutre que pour un media manquant au build.
      document.addEventListener(
        "error",
        (event) => {
          const img = event.target;
          if (!(img instanceof HTMLImageElement) || img.dataset.fallback) return;
          img.dataset.fallback = "1";
          const label = (img.alt || "").trim() || "Image indisponible";
          if (img.closest(".card__media")) {
            let hash = 0;
            for (let i = 0; i < label.length; i++) hash = (hash * 31 + label.charCodeAt(i)) >>> 0;
            const hue = hash % 360;
            const box = document.createElement("div");
            box.className = "thumb-fallback";
            box.setAttribute("aria-hidden", "true");
            box.style.background = `linear-gradient(135deg, hsl(${hue} 62% 48%), hsl(${(hue + 42) % 360} 68% 38%))`;
            box.textContent = (label.match(/\p{L}|\p{N}/u) || ["•"])[0].toUpperCase();
            img.replaceWith(box);
            return;
          }
          const block = document.createElement("span");
          block.className = "media media--missing";
          block.setAttribute("role", "img");
          block.setAttribute("aria-label", label);
          const icon = document.createElement("span");
          icon.className = "media__icon";
          icon.setAttribute("aria-hidden", "true");
          icon.textContent = "▨";
          const text = document.createElement("span");
          text.className = "media__label";
          text.textContent = label;
          block.append(icon, text);
          img.replaceWith(block);
        },
        true
      );
    </script>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer categories={categories} />
  </body>
</html>
