---
import { SITE } from "../lib/site";

interface Props { src?: string | null; alt: string; seed: string; category?: string }
const { src = null, alt, seed, category } = Astro.props;

// Teinte stable derivee du slug : un article garde toujours la meme couverture.
let hash = 0;
for (let i = 0; i < seed.length; i++) hash = (hash * 31 + seed.charCodeAt(i)) >>> 0;
const hue = (hash % 360 + 360) % 360;
const angle = 120 + (hash % 5) * 15;
---

{src ? (
  <img src={src} alt="" loading="lazy" decoding="async" />
) : (
  <div
    class="cover-card"
    aria-hidden="true"
    style={`--cover-a:hsl(${hue} 58% 42%); --cover-b:hsl(${(hue + 38) % 360} 62% 30%); --cover-angle:${angle}deg`}
  >
    <span class="cover-card__kicker">{category ?? SITE.title}</span>
    <span class="cover-card__title">{alt}</span>
    <span class="cover-card__mark">{SITE.title}</span>
  </div>
)}
