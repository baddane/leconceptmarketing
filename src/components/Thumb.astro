---
import { resolveImage } from "../lib/images.mjs";

interface Props { src?: string; alt: string; seed: string }
const { src = "", alt, seed } = Astro.props;
const resolved = resolveImage(src);

// Teinte stable dérivée du slug : deux articles gardent toujours la même vignette.
let hash = 0;
for (let i = 0; i < seed.length; i++) hash = (hash * 31 + seed.charCodeAt(i)) >>> 0;
const hue = hash % 360;
const initials = alt.replace(/[^\p{L}\p{N} ]/gu, "").trim().slice(0, 1).toUpperCase() || "•";
---

{resolved ? (
  <img src={resolved} alt="" loading="lazy" decoding="async" />
) : (
  <div
    class="thumb-fallback"
    aria-hidden="true"
    style={`background:linear-gradient(135deg, hsl(${hue} 62% 48%), hsl(${(hue + 42) % 360} 68% 38%))`}
  >{initials}</div>
)}
