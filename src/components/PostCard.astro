---
import Thumb from "./Thumb.astro";
import { formatDate, slugify } from "../lib/site";
import type { Post } from "../lib/posts";

interface Props { post: Post }
const { post } = Astro.props;
const d = post.data;
const category = d.categories[0];
---

<article class="card">
  <a class="card__media" href={post.href} tabindex="-1" aria-hidden="true">
    <Thumb src={post.image} alt={d.title} seed={post.slug} category={category} />
  </a>
  <div class="card__body">
    {category && <a class="chip" href={`/category/${slugify(category)}/`}>{category}</a>}
    <h3 class="card__title"><a href={post.href}>{d.title}</a></h3>
    {d.description && <p class="card__excerpt">{d.description}</p>}
    <p class="card__meta">
      {d.date && <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>}
      <span>{post.minutes} min de lecture</span>
    </p>
  </div>
</article>
