---
import { SITE, MENU, slugify } from "../lib/site";

interface Props { categories?: { name: string; slug: string; count: number }[] }
const { categories = [] } = Astro.props;
const year = new Date().getFullYear();
const rubriques = MENU.filter((m) => m.category).slice(0, 8);
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__cols">
      <div>
        <h3>{SITE.title}</h3>
        <p style="margin:0 0 12px">{SITE.description}</p>
        <p style="margin:0"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      </div>
      <div>
        <h3>Rubriques</h3>
        <ul>
          {rubriques.map((m) => (
            <li><a href={`/category/${slugify(m.category!)}/`}>{m.label}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Les plus lues</h3>
        <ul>
          {categories.slice(0, 6).map((c) => (
            <li><a href={`/category/${c.slug}/`}>{c.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3>Le site</h3>
        <ul>
          <li><a href="/">Accueil</a></li>
          <li><a href="/sitemap/">Sitemap</a></li>
          <li><a href="/avertissement/">Avertissement</a></li>
          <li><a href="/donnees-personnelles-et-cookies/">Données personnelles et cookies</a></li>
          <li><a href="/mentions-legales/">Mentions légales</a></li>
          <li><a href="/nous-contacter/">Nous contacter</a></li>
        </ul>
      </div>
    </div>
    <p class="site-footer__bottom">© {year} {SITE.title} — Tous droits réservés.</p>
  </div>
</footer>
