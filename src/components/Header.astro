---
import { SITE, MENU, slugify } from "../lib/site";

const { pathname } = Astro.url;
const href = (category?: string) => (category ? `/category/${slugify(category)}/` : "/");
const isActive = (path: string) => pathname === path;
---

<header class="site-header">
  <div class="wrap site-header__top">
    <a class="brand" href="/">
      <span class="brand__name">Le Concept Marketing<span class="brand__dot">.</span></span>
      <span class="brand__tag">{SITE.tagline}</span>
    </a>
    <a class="header-search" href="/recherche/" aria-label="Rechercher un article">
      <span aria-hidden="true">⌕</span> <span class="header-search__label">Rechercher</span>
    </a>
  </div>

  <nav class="mainnav" aria-label="Navigation principale">
    <ul class="mainnav__list wrap">
      {MENU.map((item) => {
        const url = href(item.category);
        return (
          <li class={item.children ? "has-sub" : undefined}>
            <a href={url} aria-current={isActive(url) ? "page" : undefined}>
              {item.label}
              {item.children && <span class="caret" aria-hidden="true">▾</span>}
            </a>
            {item.children && (
              <ul class="submenu">
                {item.children.map((child) => (
                  <li><a href={href(child.category)}>{child.label}</a></li>
                ))}
              </ul>
            )}
          </li>
        );
      })}
      <li class="mainnav__end">
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Changer de thème">◐</button>
      </li>
    </ul>
  </nav>
</header>

<script is:inline>
  document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
    const root = document.documentElement;
    const dark = getComputedStyle(root).colorScheme === "dark";
    const next = dark ? "light" : "dark";
    root.dataset.theme = next;
    try { localStorage.setItem("theme", next); } catch {}
  });
</script>
