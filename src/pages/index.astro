---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import Pagination from "../components/Pagination.astro";
import { getPosts, getCategories } from "../lib/posts";
import { SITE } from "../lib/site";

const posts = await getPosts();
const categories = await getCategories();
const perPage = SITE.postsPerPage;
const lastPage = Math.max(1, Math.ceil(posts.length / perPage));
const pageItems = posts.slice(0, perPage);
const page = { currentPage: 1, lastPage };
// Donnees structurees attendues par Google sur une page d'accueil de blog.
const schema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.title,
  url: SITE.url,
  description: SITE.description,
  inLanguage: "fr-FR",
  potentialAction: {
    "@type": "SearchAction",
    target: { "@type": "EntryPoint", urlTemplate: `${SITE.url}/recherche/?q={search_term_string}` },
    "query-input": "required name=search_term_string",
  },
};
---

<BaseLayout title={SITE.title} categories={categories}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <section class="hero">
    <div class="wrap">
      <h1>{SITE.tagline}</h1>
      <p>{SITE.description}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <h2>Derniers articles</h2>
        <a href="/sitemap/">Tout parcourir →</a>
      </div>
      <div class="grid">
        {pageItems.map((post) => <PostCard post={post} />)}
      </div>
      <Pagination page={page} base="/page/" first="/" />
    </div>
  </section>

  <section class="section" style="border-top:1px solid var(--border)">
    <div class="wrap">
      <div class="section__head"><h2>Explorer par catégorie</h2></div>
      <div class="tag-cloud">
        {categories.map((c) => (
          <a class="chip" href={`/category/${c.slug}/`}>{c.name} <span style="opacity:.65">{c.count}</span></a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
