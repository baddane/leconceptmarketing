---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCategories } from "../../lib/posts";
import { SITE } from "../../lib/site";

const categories = await getCategories();
---

<BaseLayout
  title="Nous contacter"
  description="Contactez la rédaction du Concept Marketing."
  categories={categories}
>
  <section class="hero">
    <div class="wrap">
      <p class="breadcrumb"><a href="/">Accueil</a> › Nous contacter</p>
      <h1>Nous contacter</h1>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <p>
        Une question, une proposition d’article, une demande de partenariat ou un signalement&nbsp;?
        Écrivez-nous, nous lisons tous les messages.
      </p>
      <p style="font-size:1.15rem">
        <strong><a href={`mailto:${SITE.email}`}>{SITE.email}</a></strong>
      </p>
      <p>
        Pour toute question relative à vos données, consultez notre page
        <a href="/donnees-personnelles-et-cookies/">Données personnelles et cookies</a>,
        ainsi que les <a href="/mentions-legales/">mentions légales</a>.
      </p>
    </div>
  </section>
</BaseLayout>
