---
import type { GetStaticPaths } from "astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { render } from "astro:content";
import { getAll, getPosts, getCategories } from "../lib/archive";
import { resolveImage } from "../lib/images.mjs";
import { formatDate, slugify, SITE } from "../lib/site";

export const getStaticPaths: GetStaticPaths = async () => {
  const all = await getAll();
  return all.map((item) => ({ params: { slug: item.slug }, props: { item } }));
};

const { item } = Astro.props;
const d = item.data;
const { Content } = await render(item.entry);
const categories = await getCategories();
const cover = resolveImage(d.cover);

// La meta description WordPress reprend souvent mot pour mot le premier
// paragraphe : dans ce cas le chapeau ferait doublon.
const fold = (value: string) => value.replace(/[^\p{L}\p{N}]+/gu, " ").trim().toLowerCase();
const descriptionKey = fold(d.description).slice(0, 60);
const showLede =
  d.description.length > 0 &&
  (descriptionKey.length < 20 || !fold(item.entry.body ?? "").startsWith(descriptionKey));

// Articles proches: meme categorie d'abord, complete par les plus recents.
const posts = await getPosts();
const sameCategory = posts.filter(
  (p) => p.slug !== item.slug && p.data.categories.some((c) => d.categories.includes(c))
);
const related = [...sameCategory, ...posts.filter((p) => p.slug !== item.slug)]
  .filter((p, i, arr) => arr.findIndex((x) => x.slug === p.slug) === i)
  .slice(0, 3);

const schema = {
  "@context": "https://schema.org",
  "@type": d.type === "post" ? "BlogPosting" : "WebPage",
  headline: d.title,
  description: d.description,
  datePublished: d.date?.toISOString(),
  dateModified: (d.modified ?? d.date)?.toISOString(),
  author: d.author ? { "@type": "Person", name: d.author } : undefined,
  mainEntityOfPage: new URL(item.href, Astro.site ?? SITE.url).href,
  image: cover ? new URL(cover, Astro.site ?? SITE.url).href : undefined,
  inLanguage: "fr-FR",
};
---

<BaseLayout
  title={d.title}
  description={d.description || SITE.description}
  image={cover}
  type={d.type === "post" ? "article" : "website"}
  publishedTime={d.date?.toISOString()}
  categories={categories}
>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} slot="head" />

  <article class="article">
    <div class="wrap">
      <header class="article__head">
        <p class="breadcrumb">
          <a href="/">Accueil</a>
          {d.categories[0] && (
            <> › <a href={`/category/${slugify(d.categories[0])}/`}>{d.categories[0]}</a></>
          )}
        </p>
        <div class="article__kicker">
          {d.categories.map((c: string) => (
            <a class="chip" href={`/category/${slugify(c)}/`}>{c}</a>
          ))}
        </div>
        <h1 class="article__title">{d.title}</h1>
        {showLede && <p class="article__lede">{d.description}</p>}
        <p class="article__byline">
          {d.author && <span>Par {d.author}</span>}
          {d.date && <time datetime={d.date.toISOString()}>{formatDate(d.date)}</time>}
          <span>{item.minutes} min de lecture</span>
        </p>
      </header>

      {cover && (
        <figure class="article__cover">
          <img src={cover} alt="" loading="eager" decoding="async" />
        </figure>
      )}

      <div class="prose">
        <Content />

        {d.tags.length > 0 && (
          <p class="tag-cloud" style="margin-top:2.4em">
            {d.tags.map((t: string) => <span class="chip chip--plain">{t}</span>)}
          </p>
        )}

        <p class="notice" style="margin-top:2.4em">
          <span aria-hidden="true">🗃️</span>
          <span>
            Page reconstruite à partir d’une capture archivée
            {d.source_capture && <> du {d.source_capture.slice(6, 8)}/{d.source_capture.slice(4, 6)}/{d.source_capture.slice(0, 4)}</>}.
            Certaines illustrations d’origine n’ont pas pu être récupérées.
          </span>
        </p>
      </div>
    </div>
  </article>

  {related.length > 0 && (
    <section class="section" style="border-top:1px solid var(--border)">
      <div class="wrap">
        <div class="section__head"><h2>À lire aussi</h2></div>
        <div class="grid">{related.map((p) => <PostCard post={p} />)}</div>
      </div>
    </section>
  )}
</BaseLayout>
