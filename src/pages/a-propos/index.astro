---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getAll, getPosts, getCategories } from "../../lib/archive";
import { manifestSize } from "../../lib/images.mjs";

const all = await getAll();
const posts = await getPosts();
const categories = await getCategories();
const oldest = posts[posts.length - 1]?.data.date;
const newest = posts[0]?.data.date;
const fmt = (d?: Date) => (d ? d.getUTCFullYear() : "—");
---

<BaseLayout title="À propos de cette archive" description="Comment ce site a été reconstruit à partir des captures publiques du Concept Marketing." categories={categories}>
  <section class="hero">
    <div class="wrap">
      <p class="breadcrumb"><a href="/">Accueil</a> › À propos</p>
      <h1>À propos de cette archive</h1>
      <p>Ce site est une reconstruction statique du contenu éditorial du Concept Marketing.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose">
      <h2>Ce que contient le site</h2>
      <ul>
        <li><strong>{all.length} pages</strong> restaurées, dont {posts.length} articles datés.</li>
        <li><strong>{categories.length} catégories</strong> reprises de l’arborescence d’origine.</li>
        <li>Une couverture éditoriale de <strong>{fmt(oldest)} à {fmt(newest)}</strong>.</li>
        <li>
          {manifestSize > 0
            ? `${manifestSize} illustrations rapatriées et servies localement.`
            : "Les illustrations d’origine ne sont pas encore rapatriées : leur emplacement est signalé dans les articles."}
        </li>
      </ul>

      <h2>Comment il a été reconstruit</h2>
      <p>
        Le site WordPress d’origine a perdu ses publications et sa médiathèque. Le contenu a été
        récupéré depuis les captures publiques de l’Internet Archive, puis reconverti en Markdown :
        titre, date, auteur, catégories, mots-clés et corps de texte sont extraits du balisage
        d’origine, débarrassés des encarts publicitaires, sommaires automatiques et widgets de partage.
      </p>
      <p>
        Les permaliens d’origine sont conservés à l’identique, y compris pour les archives de
        catégories, afin que les liens entrants et le référencement existants restent valides.
        Les liens internes pointant vers des pages qui n’ont pas pu être récupérées sont neutralisés
        plutôt que laissés morts.
      </p>

      <h2>Limites connues</h2>
      <ul>
        <li>Les commentaires, formulaires et espaces boutique du site d’origine ne sont pas restitués.</li>
        <li>Quelques pages construites avec un éditeur visuel n’ont pas de contenu texte exploitable.</li>
        <li>Les illustrations dépendent de la disponibilité des captures d’archive.</li>
      </ul>
    </div>
  </section>
</BaseLayout>
