---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPosts, getCategories } from "../../lib/archive";
import { formatDate } from "../../lib/site";

const posts = await getPosts();
const categories = await getCategories();

const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.date?.getUTCFullYear() ?? 0;
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = [...byYear.entries()].sort((a, b) => b[0] - a[0]);
---

<BaseLayout title="Archives" description={`Les ${posts.length} articles de l’archive, classés par année.`} categories={categories}>
  <section class="hero">
    <div class="wrap">
      <p class="breadcrumb"><a href="/">Accueil</a> › Archives</p>
      <h1>Archives</h1>
      <p>{posts.length} articles, du plus récent au plus ancien.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      {years.map(([year, items]) => (
        <div style="margin-bottom:40px">
          <div class="section__head">
            <h2>{year === 0 ? "Sans date" : year}</h2>
            <span class="chip chip--plain">{items.length}</span>
          </div>
          <ul class="search-results">
            {items.map((post) => (
              <li>
                <a href={post.href}>{post.data.title}</a>
                <p>
                  {post.data.date && <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>}
                  {post.data.categories[0] && <> · {post.data.categories[0]}</>}
                </p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
